# opendevicecontrol: give the logged-in user access to Corsair, Aula, Speedlink, Logitech and ASRock HID devices, and
# to /dev/uinput for G-key macros (typing keys / text on the user's behalf).
# Install: sudo cp 60-opendevicecontrol.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger

# All Corsair HID devices (power supplies, keyboards, mice, coolers, hubs…)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", TAG+="uaccess"

# Aula keyboards: the 2.4 GHz receiver and the USB cable connection
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="fa09", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", TAG+="uaccess"

# Speedlink ACCUSOR keyboard (reports itself as a Tt eSPORTS CHALLENGER Prime)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="264a", ATTRS{idProduct}=="3008", TAG+="uaccess"

# Logitech receivers and devices (HID++): on USB, and over Bluetooth
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:046D:*", TAG+="uaccess"

# ASRock Polychrome RGB: the motherboard's USB lighting controller
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="26ce", ATTRS{idProduct}=="01a2", TAG+="uaccess"

# Corsair RGB memory (experimental; only used when enabled in opendevicecontrol
# Settings): the chipset SMBus adapters only (Intel i801, AMD PIIX4), never
# GPU/display I2C buses. Needs the i2c-dev module. This gives the desktop
# user raw SMBus access (like OpenRGB's "i2c" group); delete these two lines
# if you don't use RAM lighting. See docs/ram.md.
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", ATTRS{name}=="SMBus I801 adapter*", TAG+="uaccess"
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", ATTRS{name}=="SMBus PIIX4 adapter*", TAG+="uaccess"

# ASUS graphics card lighting: port 1 of NVIDIA cards, the internal I2C bus
# that carries the card's RGB controller (not a display's DDC bus). Needs
# the i2c-dev module. Delete this line if you don't use it.
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", ATTRS{name}=="NVIDIA i2c adapter 1 *", TAG+="uaccess"

# System76 laptop keyboard backlight: brightness and colour. LEDs have no
# device node to give the desktop user, so only these attributes are made
# writable (any local user can then change the keyboard's colour).
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="system76*::kbd_backlight", RUN+="/bin/sh -c 'cd /sys%p && chmod a+w brightness color color_left color_center color_right color_extra 2>/dev/null; true'"

# Virtual keyboard for key actions
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
