#!/bin/sh
set -e
# Stop running copies cleanly (hands the PSU fan back to hardware control)
# before the binary is removed or replaced. Runs as root, so ask each
# user's instance through their own runtime socket. Keep in sync with the
# RPM scripts in crates/opendevicecontrol/Cargo.toml.
if [ "$1" = "remove" ] || [ "$1" = "upgrade" ]; then
    [ -x /usr/bin/opendevicecontrol ] || exit 0
    for sock in /run/user/*/opendevicecontrol-*/ipc.sock /run/user/*/opendevicecontrol-*.sock; do
        [ -S "$sock" ] || continue
        uid="${sock#/run/user/}"; uid="${uid%%/*}"
        user="$(getent passwd "$uid" | cut -d: -f1)" || continue
        [ -n "$user" ] || continue
        status=0
        su -s /bin/sh "$user" -c "XDG_RUNTIME_DIR=/run/user/$uid /usr/bin/opendevicecontrol --quit" >/dev/null 2>&1 || status=$?
        # 0: stopped cleanly. 1: not running (a stale socket).
        case "$status" in
            0|1) ;;
            *) echo "opendevicecontrol: $user's running copy did not exit cleanly (code $status); replug or power-cycle its devices if fans or lighting stay fixed" >&2 ;;
        esac
    done
fi
exit 0
